# Codex 가 실행 전에 묻는 명령 — Claude 쪽은 scripts/agent-hooks/guard.mjs 의 ask 규칙이 같은 일을 한다.
# Codex 훅은 "묻기"를 지원하지 않아서 여기에 둔다. 막는 명령(deny)은 훅이 두 도구 모두에서 막는다.
# 프로젝트를 신뢰(trust)로 둬야 읽힌다. 확인: codex execpolicy check --rules .codex/rules/team.rules git push

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "원격에 올라갑니다. 커밋·푸시·PR 은 사람이 시킬 때만 합니다.",
    match = ["git push origin feat/a", "git push --force-with-lease"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["pnpm", ["add", "remove", "rm", "uninstall", "up", "update"]],
    decision = "prompt",
    justification = "의존성은 팀이 함께 씁니다. 왜 필요한지 확인한 뒤 추가합니다.",
    match = ["pnpm add zod"],
    not_match = ["pnpm install", "pnpm test"],
)

prefix_rule(
    pattern = ["npx", "expo", "install"],
    decision = "prompt",
    justification = "의존성은 팀이 함께 씁니다. 왜 필요한지 확인한 뒤 추가합니다.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "커밋 안 된 변경이 사라집니다.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "추적하지 않는 파일이 지워집니다.",
)

prefix_rule(
    pattern = ["git", ["checkout", "restore"], "."],
    decision = "prompt",
    justification = "커밋 안 된 변경이 사라집니다.",
)

prefix_rule(
    pattern = ["git", "stash", ["drop", "clear", "pop"]],
    decision = "prompt",
    justification = "stash 는 다른 작업과 함께 씁니다.",
)

prefix_rule(
    pattern = [["pkill", "killall"]],
    decision = "prompt",
    justification = "같은 이름의 다른 프로세스(사람이 띄운 개발 서버 등)까지 끕니다.",
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-r"]],
    decision = "prompt",
    justification = "폴더를 통째로 지웁니다. 지울 대상을 확인합니다.",
)
