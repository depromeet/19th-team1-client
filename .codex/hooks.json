{
  "description": "위험 명령 막기 훅(scripts/agent-hooks/guard.mjs)을 Claude Code 와 같이 쓴다. 고치면 /hooks 에서 다시 승인해야 돈다.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/guard.mjs\" --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
